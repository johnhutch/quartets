<%# One owner-grade dashboard row (title + status + the full action cluster).
    Shared by the owner dashboard and the admin puzzles tab — the admin view
    passes show_owner: true to append the creator to the status line, and
    staff: true to unlock the moderation-grade actions. The action routes are the
    plain /puzzles ones; superusers pass their gate via the accessible_puzzles
    bypass (PuzzlesController#set_puzzle). %>
<% show_owner = local_assigns.fetch(:show_owner, false) %>
<% staff = local_assigns.fetch(:staff, false) %>
<li class="m-puzzle-list__item">
  <% title = puzzle.title.presence || "Untitled" %>
  <%# Play count drives both the status line and the delete kind: a played puzzle
      soft-deletes (tombstone, recoverable), an unplayed one hard-deletes. From
      the grouped play_counts when present, so no per-row query. %>
  <% plays = local_assigns[:play_counts] ? local_assigns[:play_counts].fetch(puzzle.id, 0) : puzzle.attempts.count %>
  <div class="m-puzzle-list__head">
    <%# Complete puzzles (published or unlisted) are playable, so the title
        opens the board; an incomplete one opens the editor instead. %>
    <%= link_to multicolor(title),
          (puzzle.complete? ? play_path(puzzle.share_token) : edit_puzzle_path(puzzle)),
          class: "m-puzzle-list__title" %>
    <span class="m-puzzle-list__status">
      <% if puzzle.deleted? %>
        Deleted
      <% elsif puzzle.published? %>
        Published &middot; <%= pluralize(plays, "play") %>
      <% elsif puzzle.complete? %>
        Unlisted &middot; link only
      <% else %>
        Incomplete
      <% end %>
      <% if show_owner %>
        &middot; <%= puzzle.user ? link_to(puzzle.user.name, user_page_path(puzzle.user.handle)) : "anonymous" %>
      <% end %>
      <%# Flag badge — only the admin tab passes report_counts. %>
      <% if (flags = local_assigns[:report_counts]&.fetch(puzzle.id, 0)).to_i.positive? %>
        &middot; <span class="m-puzzle-list__flag">⚠ <%= pluralize(flags, "report") %></span>
      <% end %>
    </span>
    <%# Admin-only funnel line — only the admin tab passes the engagement local. %>
    <% if (pulse = local_assigns[:engagement]&.[](puzzle.id)) %>
      <span class="m-puzzle-list__pulse">
        <% if pulse.starts.positive? %>
          <%= pluralize(pulse.starts, "start") %>
          &middot; <%= pulse.abandons %> abandoned (<%= number_to_percentage(pulse.abandon_rate * 100, precision: 0) %>)
        <% end %>
        <% if pulse.median_first_group_ms %>
          <% if pulse.starts.positive? %>&middot;<% end %>
          first group ~<%= clock_ms(pulse.median_first_group_ms) %>
        <% end %>
      </span>
    <% end %>
    <%# When it went out, or — for anything not published — when it was made,
        with the last-worked-on date to its left if that's a different day.
        published_at is the current stint (cleared on unpublish), so an unlisted
        puzzle always shows a created date, never a stale published one. %>
    <span class="m-puzzle-list__dates">
      <% if puzzle.published? %>
        Published on <%= list_date(puzzle.published_at) %>
      <% else %>
        <% if puzzle.edited_since_created? %>
          <span class="m-puzzle-list__edited">Updated <%= list_date(puzzle.updated_at) %></span>
        <% end %>
        Created on <%= list_date(puzzle.created_at) %>
      <% end %>
    </span>
  </div>

  <%# One filled accent button per row (the encouraged next step), then
      quiet secondary links, then the danger group pushed to the right. %>
  <div class="m-puzzle-list__actions">
    <% if puzzle.deleted? %>
      <%# Admin-only (tombstones surface only on the admin tab). Bring it back. %>
      <%= button_to restore_puzzle_path(puzzle), method: :patch, class: "m-btn m-btn--sm m-btn--go" do %>
        <%= icon(:eye) %><span>Restore</span>
      <% end %>
    <% elsif puzzle.published? %>
      <%= share_button(puzzle) %>
      <%= link_to "Play", play_path(puzzle.share_token), class: "m-puzzle-list__link" %>
      <%= link_to "Stats", stats_puzzle_path(puzzle), class: "m-puzzle-list__link" %>
      <%# Staff-only: fix a live puzzle in place. Authors don't get this on their
          own dashboard — they make it unlisted first, so a puzzle can't change
          under players mid-play. Mirrors the hatch on the play page. %>
      <% if staff %>
        <%= link_to "Edit", edit_puzzle_path(puzzle), class: "m-puzzle-list__link" %>
      <% end %>
    <% elsif puzzle.complete? %>
      <%= button_to publish_puzzle_path(puzzle), method: :patch,
            class: "m-btn m-btn--sm m-btn--go" do %>
        <%= icon(:eye) %><span>Publish</span>
      <% end %>
      <%# Unlisted but complete = playable by link, so the owner gets a Share too. %>
      <%= share_button(puzzle) %>
      <%= link_to "Edit", edit_puzzle_path(puzzle), class: "m-puzzle-list__link" %>
    <% else %>
      <%= link_to edit_puzzle_path(puzzle), class: "m-btn m-btn--sm" do %>
        <%= icon(:edit) %><span>Finish</span>
      <% end %>
    <% end %>

    <span class="m-puzzle-list__danger">
      <%# Clear a puzzle's flags when they turned out to be nothing (admin only). %>
      <% if local_assigns[:report_counts]&.fetch(puzzle.id, 0).to_i.positive? %>
        <%= link_to "Dismiss reports", dismiss_reports_admin_puzzle_path(puzzle),
              class: "m-puzzle-list__link", data: { turbo_method: :patch } %>
      <% end %>
      <% if puzzle.published? %>
        <%= link_to "Make unlisted", unpublish_puzzle_path(puzzle), class: "m-puzzle-list__unpublish",
              data: { turbo_method: :patch,
                      turbo_confirm: "Make #{title} unlisted? The link still works, it just won't be listed." } %>
      <% end %>
      <% if plays.positive? %>
        <%# Played → soft delete: pulled from the site but recoverable, stats kept. %>
        <%= button_to "Delete", puzzle, method: :delete, class: "m-puzzle-list__delete",
              data: { turbo_confirm: "Delete “#{title}”? It’ll be pulled from the site, but players’ stats are kept." } %>
      <% elsif show_owner %>
        <%# No plays + admin view → hard delete, spelled out so staff know it's permanent. %>
        <%= button_to "Hard delete", puzzle, method: :delete, class: "m-puzzle-list__delete",
              data: { turbo_confirm: "Hard delete “#{title}”? This can’t be undone." } %>
      <% else %>
        <%# No plays, your own → also permanent, but the plain label for a regular author. %>
        <%= button_to "Delete", puzzle, method: :delete, class: "m-puzzle-list__delete",
              data: { turbo_confirm: "Delete “#{title}”? This can’t be undone." } %>
      <% end %>
    </span>
  </div>
</li>
