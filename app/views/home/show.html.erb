<% content_for :title, t("home.page_title") %>

<%# Launchpad: full-bleed bands, not boxes-on-black. No .l-container — each band's
    background runs edge to edge; content is inset (never flush) except things that
    bleed on purpose (the wordmark, the fork titles). Copy lives in en.yml. %>
<div class="l-home">
  <%# Same outline buttons as the subpage topbar's auth group, same order. %>
  <div class="l-home-auth">
    <% if user_signed_in? %>
      <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "l-topbar__btn" %>
      <%= link_to "Account", edit_user_registration_path, class: "l-topbar__btn" %>
      <%= link_to "Your stuff", puzzles_path, class: "l-topbar__btn" %>
    <% else %>
      <%= link_to "Log in", new_user_session_path, class: "l-topbar__btn" %>
      <%= link_to "Sign up", new_user_registration_path, class: "l-topbar__btn" %>
    <% end %>
  </div>

  <%# HERO — one dark masthead band: the NoTimes/QUARTETS nameplate, the rules
      lede, one pitch line, and the primary nav (a sticker-weight Create CTA +
      a quiet archive link — Play itself is the Jump In band one scroll down,
      so it doesn't get a billboard here). The graphic is a solved board — the
      colorful payoff, and the clearest possible answer to "what is this site".
      Decorative: the lede already says it in words. %>
  <section class="m-hero">
    <%# The masthead gag re-rolls every load (like Multicolor + the quips). The
        inline --np-scale (1 / char count) lets CSS size any name — short ones
        run at full nameplate size, long ones shrink to span the wordmark. %>
    <% nameplate = t("home.nameplates").sample %>
    <div class="m-nameplate-stack">
      <h1 class="m-wordmark"><%= multicolor(t("home.wordmark")) %></h1>
      <span class="m-nameplate" aria-hidden="true"
            style="--np-scale: <%= (1.0 / nameplate.length).round(4) %>"><%= nameplate %></span>
    </div>

    <%# Copy and board share a row under the nameplate. Grouped so the grid can
        place them as two tracks — the board used to be absolutely positioned,
        which was fine for a small colour cluster and disastrous for something
        four rows tall (it sat straight on top of the wordmark). %>
    <div class="m-hero__copy">
      <p class="m-lede"><%= t("home.lede_html") %></p>
      <p class="m-hero__pitch"><%= t("home.hero.pitch") %></p>

      <nav class="m-hero__nav" aria-label="Primary">
        <%= link_to "#{t('home.hero.create_cta')} #{ne_arrow}", new_puzzle_path, class: "m-sticker m-hero__cta" %>
        <%= link_to "#{t('home.hero.browse_cta')} #{ne_arrow}", play_index_path, class: "m-hero__browse" %>
      </nav>

      <% unless user_signed_in? %>
        <p class="m-hero__aside"><%= t("home.hero.aside_html", signup: link_to(t("home.hero.signup"), new_user_registration_path)) %></p>
      <% end %>
    </div>

    <div class="m-hero__show" aria-hidden="true">
      <div class="m-winboard">
        <% t("home.hero.board").each_with_index do |row, i| %>
          <% color = %w[purple blue green yellow][i] %>
          <div class="m-winrow m-winrow--<%= color %>">
            <span class="m-winrow__cat"><%= row[:cat] %></span>
            <span class="m-winrow__words"><%= row[:words] %></span>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# JUMP IN — dark band, multicolor head, real puzzles as a big title list.
      Everything here is playable by definition: finished ones are filtered out
      upstream, so `done` is always false (the archive is where a completed row
      gets its ✓). %>
  <% if @puzzles.any? %>
    <section class="m-band m-band--strip">
      <h2 class="m-band__head"><%= multicolor(t("home.strip.head")) %></h2>
      <ul class="m-browse-list m-browse-list--strip">
        <% @puzzles.each do |puzzle| %>
          <%= render "play/browse_card", puzzle: puzzle, variant: "strip",
                summary: @rating_summaries[puzzle.id],
                done: false, attempt: nil %>
        <% end %>
      </ul>
      <%= link_to "#{t('home.strip.cta')} #{ne_arrow}", play_index_path, class: "m-sticker m-band__cta" %>
    </section>
  <% elsif @cleared_the_board %>
    <%# You've played everything that isn't yours. Congratulations, here's a job. %>
    <section class="m-band m-band--strip">
      <h2 class="m-band__head"><%= multicolor(t("home.strip.cleared_head")) %></h2>
      <p class="m-band__lead"><%= t("home.strip.cleared_note") %></p>
      <%= link_to "#{t('home.strip.cleared_cta')} #{ne_arrow}", new_puzzle_path, class: "m-sticker m-band__cta" %>
    </section>
  <% end %>

  <%# WHY PLAY HERE — the pitch, not a tutorial. A one-line nod to the rules, then
      what this site actually gives you, with a solved board as the graphic so the
      copy never outweighs it. %>
  <section class="m-band m-band--why">
    <%# Head at band level so it runs the full column, not the pitch grid's
        narrow left track. %>
    <h2 class="m-band__head"><%= multicolor(t("home.why.head")) %></h2>
    <div class="m-why">
      <div class="m-why__pitch">
        <ul class="m-why__list">
          <% t("home.why.features").each do |f| %>
            <li class="m-why__feature">
              <span class="m-why__lead"><%= f[:lead] %></span>
              <span class="m-why__note"><%= f[:note] %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <%# The brand's Q-quadrants — a quiet block of color to balance the pitch
          list, now that the solved board has moved up to the masthead. %>
      <div class="m-why__show" aria-hidden="true">
        <div class="m-quads">
          <span class="m-quad m-quad--yellow"></span>
          <span class="m-quad m-quad--green"></span>
          <span class="m-quad m-quad--blue"></span>
          <span class="m-quad m-quad--purple"></span>
        </div>
      </div>
    </div>
  </section>

  <%# Footer-as-section (replaces the global footer on home): the manifesto in
      stark columns, a creator line, and one quiet legal row. %>
  <footer class="m-band m-band--about m-foot">
    <h2 class="m-band__head"><%= multicolor(t("home.about.head")) %></h2>

    <div class="m-manifesto">
      <% t("home.about.columns").each do |col| %>
        <div class="m-manifesto__col">
          <% if col[:head].present? %>
            <h3 class="m-manifesto__head"><%= col[:head] %></h3>
          <% end %>
          <% if col[:body].present? %>
            <p class="m-manifesto__body"><%= col[:body] %></p>
          <% end %>
          <% if col[:bullets].present? %>
            <ul class="m-manifesto__list">
              <% col[:bullets].each do |b| %>
                <li class="m-manifesto__item">
                  <%# Labels are never links — an un-underlined heading-link reads
                      as plain text (WCAG). Links live in the note copy, underlined. %>
                  <span class="m-manifesto__label"><%= b[:label] %></span>
                  <%# note_html allows inline links (trusted copy from en.yml, never user input) %>
                  <% if b[:note_html].present? %>
                    <span class="m-manifesto__note"><%= b[:note_html].html_safe %></span>
                  <% elsif b[:note].present? %>
                    <span class="m-manifesto__note"><%= b[:note] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Privacy + terms live in the manifesto's Legalese column now; the legal
        row is just the NYT disclaimer. %>
    <p class="m-foot__legal">
      <%= t("home.about.disclaimer") %>
    </p>
  </footer>
</div>
