<%# One clickable browse card. The whole card is the play link.
    Layout: a ✓ badge floats top-right on a solved card and the title + byline
    flow around it; the meta cluster (rating + theme tags) sits under them; a
    solved card then closes with the grid you actually played, in our palette via
    cube_grid (the raw 🟨🟩🟦🟪 live only in copied share text).
    The byline is plain text here — the linked /u/:handle version lives on the
    show page, since the card is already one anchor.
    Locals: puzzle, summary, done, variant ("archive" | "strip"), attempt (the
    viewer's own finished attempt, or nil). %>
<% attempt = local_assigns[:attempt] %>
<li>
  <%= link_to play_path(puzzle.share_token),
        class: "m-browse m-browse--#{variant}#{' is-done' if done}",
        "aria-label": (done ? "#{puzzle.title} — played" : nil) do %>
    <span class="m-browse__head">
      <% if done %>
        <%# Floated, so the title and byline wrap around it rather than being
            pushed into a narrow column. Decorative — the link's aria-label
            already says "played". %>
        <span class="m-browse__done-mark" aria-hidden="true">
          <svg class="m-browse__check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="4" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M4 13 L10 19 L20 6" />
          </svg>
        </span>
      <% end %>

      <span class="m-browse__title"><%= puzzle.title %></span>
      <% if summary&.thumbs || puzzle.author_display_name.present? %>
        <span class="m-browse__byline">
          <%= render "play/likes", summary: summary %>
          <% if puzzle.author_display_name.present? %>
            <span class="m-browse__by">by <%= puzzle.author_display_name %></span>
          <% end %>
        </span>
      <% end %>
    </span>

    <span class="m-browse__meta">
      <%= render "play/difficulty_meter", summary: summary %>
      <%= render "play/themed_flag", puzzle: puzzle %>
    </span>

    <% if done && attempt&.guess_log.present? %>
      <%# m-cube supplies the grid itself — cube_grid only emits the rows. %>
      <span class="m-browse__cube m-cube" aria-hidden="true">
        <%= cube_grid(EmojiCube.new(attempt.guess_log)) %>
      </span>
    <% end %>
  <% end %>
</li>
